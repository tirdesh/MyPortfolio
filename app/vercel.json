{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tirdesh.fyi"
        }
      ],
      "destination": "https://tirdesh.fyi/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nocodenolife.vercel.app"
        }
      ],
      "destination": "https://tirdesh.fyi/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://tirdesh-blog.vercel.app/"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://tirdesh-blog.vercel.app/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
